# ainvfx-runpod · settings.env
#
# Every line is an environment variable the pod receives when it starts. `python pod.py up` sends
# the values below with each pod it creates; the Runpod template carries the same defaults for pods
# created from the browser (change them in the "Environment variables" section of the deploy page).
# bootstrap.sh reads them on the pod. Empty value = the bootstrap's own default, shown here.
#
# Lines starting with # are comments. No quotes needed, except around values that contain spaces
# ("--pre torch torchvision torchaudio" is fine either way: the whole value after = is taken).

# Which set of models.json to download: image (the course's image models, 63 GB), video (adds
# LTX 2.5, 150 GB), train (adds the training models, 215 GB).
AINVFX_PROFILE=image

# The ComfyUI release: a git tag (v0.38.2, the version the course runs) or a branch (master for
# the latest commit).
AINVFX_COMFY_TAG=v0.38.2

# The Python of the environment created on the pod (uv installs it).
AINVFX_PYTHON=3.13

# The PyTorch packages, with pip flags if wanted, and the wheel index they come from.
# Stable for CUDA 13.0 (the default), or nightlies:
#   AINVFX_TORCH=--pre torch torchvision torchaudio
#   AINVFX_TORCH_INDEX=https://download.pytorch.org/whl/nightly/cu130
AINVFX_TORCH=torch torchvision torchaudio
AINVFX_TORCH_INDEX=https://download.pytorch.org/whl/cu130

# Where the list of models comes from: a raw URL of a models.json with the same shape as this
# repository's (fork the repository, edit models.json, point this at your fork's raw file).
AINVFX_MODELS_URL=https://raw.githubusercontent.com/AInVFX/ainvfx-runpod/main/models.json

# Custom nodes to install at start: git URLs separated by spaces, for example
#   AINVFX_CUSTOM_NODES=https://github.com/kijai/ComfyUI-KJNodes https://github.com/rgthree/rgthree-comfy
# Each is cloned into custom_nodes and its requirements.txt installed. Empty: none.
AINVFX_CUSTOM_NODES=

# 1 measures the disk at start and warns when it is slow; 0 skips the measurement.
AINVFX_HEALTHCHECK=1

# 1 renders one Z-Image Turbo image at the end (proves the GPU, the kernels and the models); 0 skips it.
AINVFX_SELFTEST=1

# A fork's own bootstrap.sh, as a raw URL: fetched and run in place of this repository's.
# Empty: this repository's bootstrap.sh on main.
AINVFX_BOOTSTRAP_URL=
