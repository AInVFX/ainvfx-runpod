# ainvfx-runpod · settings.env: every choice the pod makes, one environment variable per line.
#
# `python pod.py up` sends these values with each pod; bootstrap.sh reads them on the pod. The Runpod
# template carries the same defaults for pods created from the browser (deploy page, Environment variables).
# An empty value means bootstrap.sh's own default. No quotes needed, even around spaces.
#
# Do not edit this file: `git pull` would stop on your change. Put your own lines in settings.local.env,
# next to it (ignored by git); each key there replaces the same key here. For one pod only:
# `python pod.py up image --set AINVFX_KEY=VALUE`, or `--models-url URL`. README.md lists every value.

# The profiles of models.json to download: image, 3d, video, train, several joined by + (image+3d), or all.
# `python pod.py up <profiles>` sets it for you.
AINVFX_PROFILE=image

# The ComfyUI release: a git tag, or a branch (master for the latest commit).
AINVFX_COMFY_TAG=v0.43.0

# The Python of the pod's environment (uv installs it).
AINVFX_PYTHON=3.13

# The PyTorch packages, with pip flags if wanted, and the wheel index they come from. For nightlies:
#   AINVFX_TORCH=--pre torch torchvision torchaudio
#   AINVFX_TORCH_INDEX=https://download.pytorch.org/whl/nightly/cu130
AINVFX_TORCH=torch torchvision torchaudio
AINVFX_TORCH_INDEX=https://download.pytorch.org/whl/cu130

# Where the list of models comes from: a raw link to a models.json of the same shape, or a Google Drive,
# Dropbox or GitHub share link to the file.
AINVFX_MODELS_URL=https://raw.githubusercontent.com/AInVFX/ainvfx-runpod/main/models.json

# Custom nodes to install at start: git URLs separated by spaces, for example
#   AINVFX_CUSTOM_NODES=https://github.com/kijai/ComfyUI-KJNodes https://github.com/rgthree/rgthree-comfy
AINVFX_CUSTOM_NODES=

# 1 measures the disk speed at start; 0 skips it.
AINVFX_HEALTHCHECK=1

# 1 renders one test image at the end (MOSS-Image, from the image profile); 0 skips it.
AINVFX_SELFTEST=1

# A fork's own bootstrap.sh, as a raw URL, run in place of this repository's. Empty: this repository's.
AINVFX_BOOTSTRAP_URL=
